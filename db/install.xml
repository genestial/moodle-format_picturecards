<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="course/format/picturecards/db" VERSION="2026102601" COMMENT="XMLDB file for format_picturecards"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="format_picturecards_media" COMMENT="Per-activity media configuration for the PictureCards format">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="coursemoduleid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="mediatype" TYPE="char" LENGTH="16" NOTNULL="true" DEFAULT="default" SEQUENCE="false"/>
        <FIELD NAME="iconkey" TYPE="char" LENGTH="32" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="colour" TYPE="char" LENGTH="16" NOTNULL="true" DEFAULT="blue" SEQUENCE="false"/>
        <FIELD NAME="focusx" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="50" SEQUENCE="false"/>
        <FIELD NAME="focusy" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="50" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="coursemoduleid_uix" UNIQUE="true" FIELDS="coursemoduleid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
